{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the betterleaks version pinned in the Security workflow",
      "managerFilePatterns": [
        "/^\\.github/workflows/security\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+VERSION=\"(?<currentValue>[^\"]+)\""
      ]
    }
  ]
}
